# Local Docker Postgres (used by docker compose)
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=sajawat_erp

# Prisma — must match POSTGRES_* above when using local Docker (port 5434)
# Local (no TLS required). DIRECT_URL can be the same as DATABASE_URL locally.
DATABASE_URL="postgresql://your-postgres-user:your-postgres-password@localhost:5434/sajawat_erp?schema=public"
DIRECT_URL="postgresql://your-postgres-user:your-postgres-password@localhost:5434/sajawat_erp?schema=public"
# Production (Vercel + Neon):
# DATABASE_URL = pooled host (...-pooler...) with sslmode=require&pgbouncer=true
# DIRECT_URL   = direct host (no -pooler) with sslmode=require  — required for prisma migrate deploy

# Optional Redis cache for dropdowns
REDIS_URL="redis://localhost:6379"

# App login (required — no defaults in code; missing values abort server start)
AUTH_USERNAME=your-auth-username
AUTH_PASSWORD=your-auth-password
# Use a long random string; anyone who knows this can forge the session cookie
AUTH_SESSION_TOKEN=replace-with-a-long-random-string
